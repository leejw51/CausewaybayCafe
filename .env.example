MUSE_API_KEY=
CAFE_OWNER_WALLET=
CAFE_PORT=8788
CAFE_BIND=0.0.0.0
CAFE_FRONTEND_BIND=0.0.0.0
CAFE_FRONTEND_PORT=8791
CAFE_PUBLIC_URL=http://localhost:8791
# Default database: ~/.causewaybaycafe/cafe.sqlite
# CAFE_DATABASE=/absolute/path/to/cafe.sqlite
# CAFE_HOME=/absolute/path/to/.causewaybaycafe
CAFE_AI_PROVIDER=meta
CAFE_AI_MODEL=muse-spark-1.3
# Optional explicit alternatives: openai or grok. Never selected automatically.
OPENAI_API_KEY=
XAI_API_KEY=
# Set a provider-appropriate CAFE_AI_MODEL when changing provider.
# HTTP/3: PEM certificate and private key, plus UDP bind address.
CAFE_TLS_CERT=
CAFE_TLS_KEY=
CAFE_HTTP3_ADDR=0.0.0.0:8789
# Demo credits only; enabled automatically in simulation. Keep off in production.
CAFE_FAUCET_ENABLED=0

# Initial default only; subsequent Owner mode changes persist in SQLite.
CAFE_SIMULATION=1

# Supervisor defaults to 1: guest chat and requested order pictures use Meta even with demo orders/payments.
# 0 is for offline automated tests only. Background AI still requires Run.
CAFE_GUEST_AI=1

# Owner/staff chat may use Meta in demo service mode after pressing Run.
CAFE_MANAGEMENT_AI=1
